@startuml MarathonClassDiagram
skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction

enum RaceDistance {
  TEN_KM
  HALF_MARATHON
  FULL_MARATHON
}

interface VipAllowed <<interface>> {
  + canEnterVip(): boolean
}

interface PaidWorker <<interface>> {
  + calculatePayment(): double
}

class MarathonEvent {
  - String city
  - Race[] races
  - int raceCount
  - EventWorker[] workers
  - int workerCount
  - VipArea vipArea
  - static final double POLICE_SECURITY_COST = 50000
  + addRace(race: Race): void
  + addWorker(worker: EventWorker): void
  + calculateIncome(): double
  + calculateExpenses(): double
  + announceWinners(): void
}

class Race {
  - RaceDistance distance
  - String startTime
  - double participationCost
  - Runner[] runners
  - int runnerCount
  + addRunner(runner: Runner): void
  + setRunnerFinishTime(runnerName: String, finishTime: double): void throws RaceActionException
  + getWinner(): Runner throws RaceActionException
  + calculateIncome(): double
}

class Runner {
  - String name
  - double finishTime
  + finishRace(time: double): void
}

class VipRunner {
  - String sponsorGift
  + receiveSponsorGift(gift: String): void
  + canEnterVip(): boolean
}

abstract class EventWorker <<abstract>> {
  # String name
  # String email
  + sendUpdate(message: String): void
}

class Medic {
  - String firstAidRefreshDate
  - static final double PAYMENT = 500
  + treatInjuredRunner(runner: Runner): void
  + calculatePayment(): double
}

class SecurityGuard {
  - String unitName
  + secureEvent(): void
  + canEnterVip(): boolean
}

class Physiotherapist {
  - String specialization
  - static final double PAYMENT = 800
  + treatRunner(runner: Runner): void
  + calculatePayment(): double
  + canEnterVip(): boolean
}

class VipArea {
  - Object[] peopleInside
  - int peopleCount
  + canEnter(person: Object): boolean
  + addPerson(person: Object): void throws VipAccessException
}

class VipAccessException {
  - String message
  + getMessage(): String
}

class RaceActionException {
  - String message
  + getMessage(): String
}

class Object

VipRunner --|> Runner
Medic --|> EventWorker
SecurityGuard --|> EventWorker
Physiotherapist --|> EventWorker

VipRunner ..|> VipAllowed
SecurityGuard ..|> VipAllowed
Physiotherapist ..|> VipAllowed
Medic ..|> PaidWorker
Physiotherapist ..|> PaidWorker

MarathonEvent "1" *-- "3" Race
Race "1" -- "0..*" Runner
MarathonEvent "1" -- "0..*" EventWorker
MarathonEvent "1" *-- "1" VipArea
VipArea "1" -- "0..*" Object
Race ..> RaceDistance : uses
VipArea ..> VipAccessException : throws
Race ..> RaceActionException : throws
@enduml
